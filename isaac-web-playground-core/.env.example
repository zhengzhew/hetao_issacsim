PORT=8080
# mjpeg is the default: WebRTC cannot cross a VPN that NATs the client.
# Use native only with a same-network viewer AND --livestream on the bridge.
ISAAC_STREAM_RENDERER=mjpeg
ISAAC_STREAM_HOST=127.0.0.1
ISAAC_SIGNAL_PORT=49100
ISAAC_MEDIA_PORT=47998
ISAAC_BRIDGE_HOST=127.0.0.1
ISAAC_BRIDGE_PORT=8765
ISAAC_DEFAULT_SCENE=warehouse
ISAAC_DEFAULT_ROBOT=jetbot
ISAAC_TELEOP_WATCHDOG=0.40
# ISAAC_PUBLIC_IP=<host-ip>
# ISAAC_SIM_DIR=/path/to/isaacsim
# ISAAC_ASSET_ROOT=https://.../Assets/Isaac/6.0
