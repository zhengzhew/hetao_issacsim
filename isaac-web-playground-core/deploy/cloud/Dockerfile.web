ARG PYTHON_IMAGE=python:3.12-slim-bookworm
ARG NODE_IMAGE=node:22-bookworm-slim
FROM ${PYTHON_IMAGE} AS assets
WORKDIR /build
COPY configs/challenge-assets.lock.json configs/challenge-assets.lock.json
COPY scripts/fetch_challenge_assets.py scripts/fetch_challenge_assets.py
RUN --mount=from=assets-cache,target=/asset-cache,ro python scripts/fetch_challenge_assets.py --cache /asset-cache

FROM ${NODE_IMAGE} AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --registry=https://registry.npmjs.org
COPY src ./src
COPY scripts/build_native.mjs ./scripts/build_native.mjs
RUN mkdir web && node scripts/build_native.mjs && npm prune --omit=dev

FROM ${NODE_IMAGE}
WORKDIR /app
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/web/native-sdk.js ./web/native-sdk.js
COPY --from=assets /build/uploads/challenges /opt/challenge-assets
COPY package.json ./
COPY server ./server
COPY web ./web
COPY configs/scenes.json configs/robots.json configs/challenges.json ./configs/
COPY deploy/cloud/health.mjs ./deploy/cloud/health.mjs
ENV NODE_ENV=production ISAAC_CHALLENGE_ASSETS_DIR=/opt/challenge-assets
USER 1234:1234
CMD ["node", "server/platform-main.js"]
